rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // القراءة لكل من هو داخل التطبيق (مسجّل دخول)
    match /{doc=**} { allow read: if signedIn(); }

    // اللاعب: يكتب سجلّ حسابه هو فقط
    match /players/{uid} {
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // التوقعات: صاحبها فقط، قبل بداية المباراة، ولا تُحذف
    match /predictions/{pid} {
      allow create, update: if signedIn()
        && pid.split('__')[0] == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.time.toMillis() < get(/databases/$(database)/documents/fixtures/$(request.resource.data.fixtureId)).data.kickoff;
      allow delete: if false;
    }

    // توقّع الهداف: صاحبه فقط (معرّف الوثيقة = uid__league)
    match /scorerPicks/{pid} {
      allow write: if signedIn() && pid.split('__')[0] == request.auth.uid;
    }

    // رمز جهاز الإشعارات: صاحبه فقط
    match /fcmTokens/{uid} {
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // محتوى يُدار من لوحة الإدارة (محمي عملياً برمز الإدارة في الواجهة)
    match /fixtures/{id}          { allow write: if signedIn(); }
    match /news/{id}             { allow write: if signedIn(); }
    match /banners/{id}          { allow write: if signedIn(); }
    match /scorerCandidates/{id} { allow write: if signedIn(); }
    match /notifications/{id}    { allow write: if signedIn(); }
  }
}
